---
import favIcon from '~/assets/favicons/favicon.svg';
import favIconSvg from '~/assets/images/logosentra.png';
import appleTouchIcon from '~/assets/images/logosentra.png';
---

<link rel="shortcut icon" href={favIcon} />
<link rel="icon" type="image/svg+xml" href={favIconSvg.src} />
<link rel="mask-icon" href={favIconSvg.src} color="#8D46E7" />
<link rel="" sizes="180x180" href={appleTouchIcon.src} />
