---
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';

const allPosts = await getCollection('post');
allPosts.sort(
  (a, b) => (b.data?.publishDate ?? new Date(0)).valueOf() - (a.data?.publishDate ?? new Date(0)).valueOf()
);
---

<div class="grid grid-cols-1 gap-4 md:grid-cols-2 lg:grid-cols-2">
  {
    allPosts.map((post) => (
      <div class="flex flex-col rounded-sm overflow-hidden shadow-md h-full">
        <div class="relative aspect-video">
          <Image
            src={post.data.image || 'https://via.placeholder.com/400x300'}
            alt={post.data.title}
            width={50}
            height={310}
            class="object-cover w-full h-full"
          />
          <div class="absolute bottom-0 left-0 right-0 bg-black bg-opacity-50 text-white text-xs p-2">
            {post.data?.publishDate?.toLocaleDateString()}
          </div>
        </div>
        <div class="p-4 flex flex-col flex-grow">
          <h2 class="text-xl font-bold mb-2">{post.data.title}</h2>
          <p class="text-gray-600 mb-4 flex-grow">{post.data.excerpt}</p>
          <a href={`/${post.slug}`} class="text-blue-500 hover:underline mt-auto">
            Baca selengkapnya
          </a>
        </div>
      </div>
    ))
  }
</div>
