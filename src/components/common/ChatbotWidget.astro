<!-- Chatbox -->
<div x-data="{ open: false }" x-cloak class="fixed bottom-6 right-6 z-50 flex items-center space-x-2">
  <!-- Floating Text Label -->
  <div
    class="bg-white text-gray-800 text-xs font-medium px-3 py-2 rounded shadow-lg animate-bounce dark:bg-gray-800 dark:text-gray-200"
  >
    Klik untuk informasi lebih lanjut 👉
  </div>

  <!-- Floating Chat Button -->
  <button
    @click="open = true"
    class="w-14 h-14 bg-green-600 text-white rounded-full shadow-lg hover:bg-green-700 focus:outline-none dark:bg-green-700 dark:hover:bg-green-600"
  >
    💬
  </button>

  <!-- Modal Overlay -->
  <div
    x-show="open"
    x-transition
    class="fixed inset-0 bg-black bg-opacity-80 flex items-center justify-center"
    @click.self="open = false"
  >
    <!-- Chat Container -->
    <div
      class="bg-white dark:bg-gray-900 dark:text-white max-w-md w-full rounded-lg shadow-lg p-4 relative chat-modal-fix"
      @click.stop
    >
      <!-- Close Button -->
      <button
        @click="open = false"
        class="absolute top-2 right-2 text-gray-500 hover:text-gray-800 font-bold text-xl dark:text-gray-300 dark:hover:text-white"
      >
        &times;
      </button>

      <h1 class="text-2xl font-bold mb-2 text-center">FAQ | Chatbot</h1>
      <h3 class="mb-4 text-center text-gray-500 text-sm dark:text-gray-400">
        Tanyakan kepada Agen AI kami untuk informasi lebih lanjut seputar Sentra Kreasi.
      </h3>

      <div
        id="chat-messages"
        class="h-72 overflow-y-auto border border-gray-200 dark:border-gray-700 p-2 mb-2 rounded text-sm dark:bg-gray-800 dark:text-white"
      >
      </div>

      <div class="flex mb-2">
        <input
          id="message-input"
          type="text"
          placeholder="Ketik pesan Anda di sini..."
          class="flex-1 p-2 border rounded-l dark:bg-gray-800 dark:border-gray-600 dark:text-white"
        />
        <button
          id="send-button"
          onclick="sendMessage()"
          class="px-3 bg-green-500 text-white rounded-r hover:bg-green-600 dark:bg-green-700 dark:hover:bg-green-600 z-50"
          style="pointer-events: auto;"
        >
          Kirim
        </button>
      </div>

      <a
        href="https://studio.sasana.ai/chat/d3216ab6-e5e5-4039-a0c2-07c736dd7252"
        target="_blank"
        class="block text-center text-xs text-green-400 hover:underline dark:text-green-300"
      >
        Coba tautan cadangan jika tidak berfungsi
      </a>
    </div>
  </div>
</div>

<!-- JS Logic -->
<script type="module">
  import { marked } from 'marked';

  const url = 'https://sasana-be-chat-ts.sasana.ai/v3/chat';
  const headers = {
    'Content-Type': 'application/json',
    'X-API-KEY': import.meta.env.PUBLIC_SASANA_API_KEY,
  };

  function appendMessage(text, sender) {
    const chatMessages = document.getElementById('chat-messages');
    const msgDiv = document.createElement('div');
    msgDiv.classList.add('fade-in', 'mb-1', 'p-2', 'rounded', 'max-w-full', 'break-words');

    if (sender === 'user') {
      msgDiv.classList.add('bg-green-100', 'text-right', 'ml-auto', 'dark:bg-green-800', 'dark:text-white');
      msgDiv.textContent = 'You: ' + text;
    } else {
      msgDiv.classList.add('bg-green-100', 'text-left', 'mr-auto', 'dark:bg-gray-700', 'dark:text-white');
      msgDiv.innerHTML = 'Chatbot: ' + marked.parse(text);
    }

    if (chatMessages) {
      chatMessages.appendChild(msgDiv);
      chatMessages.scrollTop = chatMessages.scrollHeight;
    }
  }

  sendMessage = function () {
    const messageInput = document.getElementById('message-input');
    const message = messageInput instanceof HTMLInputElement ? messageInput.value.trim() : '';
    if (!message) return;

    appendMessage(message, 'user');
    if (messageInput instanceof HTMLInputElement) {
      messageInput.value = '';
    }

    const data = {
      message,
      userId: crypto.randomUUID(),
      sessionId: crypto.randomUUID(),
      agentId: 'd3216ab6-e5e5-4039-a0c2-07c736dd7252',
    };

    fetch(url, {
      method: 'POST',
      headers: headers,
      body: JSON.stringify(data),
    })
      .then(async (response) => {
        const json = await response.json();

        if (!response.ok) {
          if (json && json.message) {
            appendMessage(`❗ Error: ${json.message}`, 'bot');
            appendMessage(`❗ Error Code: ${json.error}`, 'bot');
            appendMessage(`❗ Error Status: ${json.statusCode}`, 'bot');
          } else {
            appendMessage('❗ Something went wrong. Please try again.', 'bot');
          }
          throw new Error(json.message || 'Unknown error');
        }

        const reply = json?.data?.content || 'No response received.';
        appendMessage(reply, 'bot');
      })
      .catch((error) => {
        console.error(error);
        appendMessage('🚫 Failed to connect. Please check your internet or try again later.', 'bot');
      });
  };

  // Mobile fix: scroll input ke tengah saat fokus
  document.addEventListener('DOMContentLoaded', () => {
    const input = document.getElementById('message-input');
    input?.addEventListener('focus', () => {
      setTimeout(() => {
        input.scrollIntoView({ behavior: 'smooth', block: 'center' });
      }, 300);
    });
  });
</script>

<style>
  .chat-modal-fix {
    max-height: 90vh;
    overflow-y: auto;
    -webkit-overflow-scrolling: touch;
    overscroll-behavior: contain;
  }

  input:focus {
    scroll-margin-bottom: 150px;
  }
</style>
