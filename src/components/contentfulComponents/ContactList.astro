---
import WidgetWrapper from '~/components/ui/WidgetWrapper.astro';
import Headline from '~/components/ui/Headline.astro';
import ItemGrid2 from '~/components/ui/ItemGrid2.astro';
import type { Asset, EntryFieldTypes } from 'contentful';
import { contentfulClient } from '~/lib/contentful';

const {
  columns = 4,

  id,
  isDark = false,
  classes = {},
  bg = await Astro.slots.render('bg'),
} = Astro.props;

interface ContactsType {
  contentTypeId: string;
  fields: {
    jenisKontak: EntryFieldTypes.Text;
    logo: EntryFieldTypes.Text;
    judulKontak: EntryFieldTypes.Text;
    deskripsiKontak: EntryFieldTypes.Text;
    linkKontak: EntryFieldTypes.Text;
  };
}

// Fetch the entry and include linked assets
const entries = await contentfulClient.getEntries<ContactsType>({
  content_type: 'contactsType',
});

const ContentItems = entries.items.map((item) => {
  return {
    title: item.fields.judulKontak,
    icon: item.fields.logo,
    description: item.fields.deskripsiKontak,
    link: item.fields.linkKontak,
  };
});

function shuffleArray(array: any[]): any[] {
  for (let i = array.length - 1; i > 0; i--) {
    const j = Math.floor(Math.random() * (i + 1));
    [array[i], array[j]] = [array[j], array[i]];
  }
  return array;
}

const randomizedItems = shuffleArray(ContentItems);
---

<WidgetWrapper id={id} isDark={isDark} containerClass={`max-w-7xl mx-auto ${classes?.container ?? ''}`} bg={bg}>
  <div class="flex justify-center items-center w-full">
    <ItemGrid2
      items={randomizedItems}
      columns={columns}
      classes={{
        container: 'gap-4 md:gap-6 flex justify-center items-center',
        panel:
          'rounded-lg shadow-[0_4px_30px_rgba(0,0,0,0.1)] dark:shadow-[0_4px_30px_rgba(0,0,0,0.1)] backdrop-blur border border-[#ffffff29] bg-white dark:bg-slate-900 p-6 text-center flex flex-col items-center justify-center w-full h-full',
        title: 'text-center',
        deskripsi: 'text-center',
        image: 'mx-auto w-full rounded-lg bg-gray-500 shadow-lg',
        ...((classes?.items as {}) ?? {}),
      }}
    />
  </div>

  {/* Tambahkan slot "more" di sini */}
  <div class="mt-8">
    <slot name="more" />
  </div>
</WidgetWrapper>
