---
import Image from '~/components/common/Image.astro';
import type { Asset, EntryFieldTypes } from 'contentful';
import { contentfulClient } from '~/lib/contentful';

interface ProdukType {
  contentTypeId: string;
  fields: {
    namaProduk: EntryFieldTypes.Text;
    deskripsi: EntryFieldTypes.Text;
    gambar: EntryFieldTypes.AssetLink;
  };
}

// Fetch the entry and include linked assets
const entries = await contentfulClient.getEntries<ProdukType>({
  content_type: 'produkType',
});

const ContentItems = entries.items.map((item) => {
  const imageAsset: Asset | undefined = entries.includes?.Asset?.find(
    (asset: Asset) => asset?.sys?.id === item?.fields?.gambar?.sys?.id
  );

  const imageURL: string | null =
    typeof imageAsset?.fields?.file?.url === 'string' ? `https:${imageAsset.fields.file.url}` : null;

  return {
    title: item.fields.namaProduk,
    description: item.fields.deskripsi,
    image: { src: imageURL, alt: item.fields.namaProduk },
  };
});

function shuffleArray(array: any[]): any[] {
  for (let i = array.length - 1; i > 0; i--) {
    const j = Math.floor(Math.random() * (i + 1));
    [array[i], array[j]] = [array[j], array[i]];
  }
  return array;
}

const randomizedItems = shuffleArray(ContentItems);

console.log(randomizedItems);
---

  <div class="mx-auto max-w-7xl p-4 md:px-8">
    {
      randomizedItems.length > 0 ? (
        randomizedItems.map((item, index) => {
          const isReversed = index % 2 !== 0;

          return (
            <div class={`md:flex ${isReversed ? 'md:flex-row-reverse' : ''} md:gap-16 mb-8`}>
              <div class="md:basis-1/2 self-center">
                <h3 class="text-xl font-bold">{item.title}</h3>
                <p>{item.description}</p>
              </div>
              <div class="md:basis-1/2">
                <Image src={item.image.src} alt={item.image.alt} />
              </div>
            </div>
          );
        })
      ) : (
        <p>No items found.</p>
      )
    }
  </div>
