---
import WidgetWrapper from '~/components/ui/WidgetWrapper.astro';
import Headline from '~/components/ui/Headline.astro';
import ItemGrid2 from '~/components/ui/ItemGrid2.astro';
import type { Asset, EntryFieldTypes } from 'contentful';
import { contentfulClient } from '~/lib/contentful';

import { Icon } from 'astro-icon/components';
import { getPermalink } from '~/utils/permalinks';

interface TeamListType {
  contentTypeId: string;
  fields: {
    nama: EntryFieldTypes.Text;
    foto: EntryFieldTypes.AssetLink;
    deskripsi: EntryFieldTypes.Text;
  };
}

// Fetch the entry and include linked assets
const entries = await contentfulClient.getEntries<TeamListType>({
  content_type: 'teamListType',
});

function truncateString(str: string, length: number = 100): string {
  if (!str || str.length <= length) {
    return str;
  }
  return str.substring(0, length) + '...';
}

const ContentItems = entries.items.map((item) => {
  const imageAsset: Asset | undefined = entries.includes?.Asset?.find(
    (asset: Asset) => asset?.sys?.id === item?.fields?.foto?.sys?.id
  );

  const imageURL: string | null = typeof imageAsset?.fields?.file?.url === 'string' ? imageAsset.fields.file.url : null;

  return {
    title: item.fields.nama,
    description: truncateString(item.fields.deskripsi),
    image: item.fields.foto ? { src: imageURL, alt: item.fields.nama } : null,
  };
});

const {
  title = await Astro.slots.render('title'),
  subtitle = await Astro.slots.render('subtitle'),
  tagline = await Astro.slots.render('tagline'),
  columns = 3,
  id,
  isDark = false,
  classes = {},
  bg = await Astro.slots.render('bg'),
} = Astro.props;
---

<WidgetWrapper id={id} isDark={isDark} containerClass={`max-w-7xl mx-auto ${classes?.container ?? ''}`} bg={bg}>
  {
    Array.from({ length: Math.ceil(ContentItems.length / columns) }).map((_, rowIndex) => (
      <div class="py-2 flex flex-col justify-center items-center w-full">
        <ItemGrid2
          key={`row-${rowIndex}`}
          items={ContentItems.slice(rowIndex * columns, (rowIndex + 1) * columns)}
          columns={Math.min(columns, ContentItems.length - rowIndex * columns)}
          classes={{
            container: 'gap-4 md:gap-6 flex justify-center items-center',
            panel:
              'rounded-lg shadow-[0_4px_30px_rgba(0,0,0,0.1)] dark:shadow-[0_4px_30px_rgba(0,0,0,0.1)] backdrop-blur border border-[#ffffff29] bg-white dark:bg-slate-900 p-6 text-center flex flex-col items-center justify-center w-full h-full',
            title: 'text-center',
            description: 'text-center',
            ...((classes?.items as {}) ?? {}),
          }}
        />
      </div>
    ))
  }

  {/* Tambahkan slot "more" di sini */}
  <div class="mt-8">
    <slot name="more" />
  </div>
</WidgetWrapper>
