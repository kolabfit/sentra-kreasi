---
import { Icon } from 'astro-icon/components';
import { twMerge } from 'tailwind-merge';
import type { ItemGrid } from '~/types';
import Button from './Button.astro';

const {
  items = [],
  columns = 2,
  defaultIcon = '',
} = Astro.props as ItemGrid;

const defaultIconClass = 'text-primary'; // Define it separately
---

<div
  class={twMerge(
    `grid gap-8 gap-x-12 sm:gap-y-8 ${
      columns === 4
        ? 'lg:grid-cols-4 md:grid-cols-3 sm:grid-cols-2'
        : columns === 3
        ? 'lg:grid-cols-3 sm:grid-cols-2'
        : columns === 2
        ? 'sm:grid-cols-2'
        : ''
    }`,
  )}
>
  {items.map(({ title, description, icon, image, callToAction, link, classes: itemClasses = {} }) => {
    const Wrapper = link ? 'a' : 'div'; // Determine the wrapper element

    return (
      <Wrapper
        href={link || undefined}
        class={twMerge(
          'relative flex flex-col intersect-once intersect-quarter intercept-no-queue motion-safe:md:opacity-0 motion-safe:md:intersect:animate-fade',
          'bg-white dark:bg-slate-900 rounded-lg shadow-md p-6',
          'flex flex-col justify-between items-center h-full min-h-[200px]', // Ensure consistent height
          itemClasses?.panel
        )}
        {...(link && { target: '_blank', rel: 'noopener noreferrer' })} 
      >
        <div class="flex flex-col items-center text-center w-full">
          {(icon || defaultIcon) && (
            <Icon
              name={icon || defaultIcon}
              class={twMerge('mb-4 w-10 h-10', defaultIconClass, itemClasses?.icon)}
            />
          )}
          {image && (
            <div class="mb-4 flex justify-center">
              <img
                src={image?.src}
                width="550"
                height="130"
                style="max-height: 500px; object-fit: cover"
                alt={image?.alt || ''}
                class="rounded"
              />
            </div>
          )}
          <div class={twMerge('text-xl font-bold mb-2', itemClasses?.title)}>{title}</div>
          {description && (
            <p
              class={twMerge('text-muted mt-2', itemClasses?.description)}
              set:html={description}
            />
          )}
        </div>
        {callToAction && (
          <div class="mt-4">
            <Button {...callToAction} />
          </div>
        )}
      </Wrapper>
    );
  })}
</div>
