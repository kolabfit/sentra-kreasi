---
import { Icon } from 'astro-icon/components';

const { 
  logo = 'tabler:map-pin', 
  text = 'Jl. Raya Banjaran KM 14, Gg. Kesehatan No 124, RT 05/ RW 06, Desa Sukasari, Kec. Pameungpeuk Bandung',
  href = 'https://maps.app.goo.gl/RdQzHqrf1FS4N3qV6'
} = Astro.props;
---

<section class="not-prose">
  <a href={href} target="_blank">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 py-4 text-md text-center font-medium">
      <strong>Lokasi Kami: </strong> <Icon name={logo} class="w-5 h-5 inline-block align-text-bottom" /> {text}
    </div>
    <div class="flex justify-center">
      <iframe src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d8151.846099569261!2d107.58888566297802!3d-7.022268366248118!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x2e68ebe905f278b7%3A0x21b57c0c114f42fb!2sJl.%20Raya%20Banjaran%20Barat%20No.Km%2014%20124%2C%20RW.6%2C%20Sukasari%2C%20Kec.%20Pameungpeuk%2C%20Kabupaten%20Bandung%2C%20Jawa%20Barat%2040376!5e0!3m2!1sen!2sid!4v1733906556441!5m2!1sen!2sid" width="600" height="450" style="border:0;" allowfullscreen="" loading="lazy" referrerpolicy="no-referrer-when-downgrade"></iframe>
    </div>
  </a>
</section>
