---
import Layout from '~/layouts/PageLayout.astro';
import Headline from '~/components/blog/Headline.astro';
import { contentfulClient } from '~/lib/contentful';
import { Icon } from 'astro-icon/components';
import { getPermalink } from '~/utils/permalinks';
import { marked } from 'marked';
import type { Asset, EntryFieldTypes } from 'contentful';

interface ArtikelItemType {
  contentTypeId: string;
  fields: {
    idHalaman: EntryFieldTypes.Text;
    judul: EntryFieldTypes.Text;
    deskripsi: EntryFieldTypes.Text;
    gambar: EntryFieldTypes.AssetLink;
    tanggal: EntryFieldTypes.Date;
    tags: EntryFieldTypes.Text[];
  };
}

const itemsPerPage = 4;
const currentPagination = parseInt(Astro.url.searchParams.get('page') || '1');

// Fetch current page entries
const entries = await contentfulClient.getEntries<ArtikelItemType>({
  content_type: 'artikelItemType',
  skip: (currentPagination - 1) * itemsPerPage,
  limit: itemsPerPage,
});

function truncateString(str: string, length: number = 200): string {
  if (!str || str.length <= length) {
    return str;
  }
  return str.substring(0, length) + '...';
}

const ContentItems = entries.items.map((item) => {
  const imageAsset: Asset | undefined = entries.includes?.Asset?.find(
    (asset: Asset) => asset?.sys?.id === item?.fields?.gambar?.sys?.id
  );

  const imageURL: string | null = typeof imageAsset?.fields?.file?.url === 'string' ? imageAsset.fields.file.url : null;
  const descriptionHTML = item.fields.deskripsi ? marked.parse(item.fields.deskripsi) : '';

  return {
    id: item.fields.idHalaman,
    title: item.fields.judul,
    description: truncateString(descriptionHTML as string),
    image: { src: imageURL, alt: item.fields.judul },
    publishDate: item.fields.tanggal,
    tags: Array.isArray(item.fields.tags) ? item.fields.tags : [],
  };
});

// Use entries.total to get total pages
const totalPages = Math.ceil(entries.total / itemsPerPage);

var shouldDisableButton = false;
var buttonClass = 'px-4 py-2 bg-gray-200 dark:bg-slate-600 rounded';

if (currentPagination >= totalPages) {
  shouldDisableButton = true;
  buttonClass = 'text-muted px-4 py-2 bg-gray-400 dark:bg-slate-800 rounded cursor-not-allowed';
}

const metadata = {
  title: `Artikels - Page ${currentPagination}`,
};
---

<Layout metadata={metadata}>
  <section class="px-6 sm:px-6 py-12 sm:py-16 lg:py-20 mx-auto max-w-4xl">
    <Headline title="Artikels" subtitle="Cek artikel - artikel menarik dari kami" />

    <!-- Items -->
    <ul>
      {
        ContentItems.map((post) => (
          <li class="mb-12 md:mb-20">
            <article class="max-w-md mx-auto md:max-w-none grid gap-6 md:gap-8 intersect-once intersect-quarter motion-safe:md:opacity-0 motion-safe:md:intersect:animate-fade md:grid-cols-2">
              <a class="relative block group" href={getPermalink(`/artikel/${post.id}`)}>
                <div class="relative h-0 pb-[56.25%] md:pb-[75%] md:h-72 lg:pb-[56.25%] overflow-hidden bg-gray-400 dark:bg-slate-700 rounded shadow-lg">
                  <img
                    src={post.image.src}
                    alt={post.image.alt}
                    class="absolute inset-0 object-cover w-full h-full mb-6 rounded shadow-lg bg-gray-400 dark:bg-slate-700"
                    width={900}
                    sizes="(max-width: 900px) 400px, 900px"
                  />
                </div>
              </a>
              <div class="mt-2">
                <header>
                  <div class="mb-1">
                    <span class="text-sm">
                      <Icon name="tabler:clock" class="w-3.5 h-3.5 inline-block -mt-0.5 dark:text-gray-400" />
                      <time datetime={String(post.publishDate)} class="inline-block">
                        {post.publishDate}
                      </time>
                    </span>
                  </div>
                  <h2 class="text-xl sm:text-2xl font-bold leading-tight mb-2 font-heading dark:text-slate-300">
                    {post.id ? (
                      <a
                        class="inline-block hover:text-primary dark:hover:text-blue-700 transition ease-in duration-200"
                        href={getPermalink('/artikel/' + post.id)}
                      >
                        {post.title}
                      </a>
                    ) : (
                      post.title
                    )}
                  </h2>
                </header>

                {post.description && (
                  <p class="flex-grow text-muted dark:text-slate-400 text-lg" set:html={post.description} />
                )}

                <footer class="mt-5">
                  <ul class="text-sm">
                    {post.tags.map((tag) => (
                      <li class="bg-gray-100 dark:bg-slate-700 inline-block mr-2 rtl:mr-0 rtl:ml-2 mb-2 py-0.5 px-2 lowercase font-medium">
                        <a class="text-muted dark:text-slate-300 hover:text-primary dark:hover:text-gray-200">{tag}</a>
                      </li>
                    ))}
                  </ul>
                </footer>
              </div>
            </article>
          </li>
        ))
      }
    </ul>

    <div class="flex justify-center text-center gap-4 sm:gap-6">
      <button
        onclick="previousPage()"
        class={currentPagination == 1
          ? 'text-muted px-4 py-2 bg-gray-400 dark:bg-slate-800 rounded cursor-not-allowed'
          : 'px-4 py-2 bg-gray-200 dark:bg-slate-800 rounded'}
      >
        Previous
      </button>
      <button id="nextbutton" onclick="nextPage()" class={buttonClass} disabled={shouldDisableButton}> Next </button>
    </div>
  </section>
</Layout>

<script data-astro-rerun data-astro-run>
  function nextPage() {
    const currentPage = parseInt(new URLSearchParams(window.location.search).get('page') || '1', 10);
    if (currentPage > 0) {
      window.location.assign(window.location.origin + window.location.pathname + '?page=' + (currentPage + 1));
    }
  }

  function previousPage() {
    const currentPage = parseInt(new URLSearchParams(window.location.search).get('page') || '1', 10);
    if (currentPage > 1) {
      window.location.assign(window.location.origin + window.location.pathname + '?page=' + (currentPage - 1));
    }
  }
</script>
