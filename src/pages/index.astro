      },
    ]}
  >
    <Fragment slot="title">
      KOMUNITAS KAMPUNG DIGITAL&nbsp;<br class="block sm:hidden" /><span class="sm:whitespace-nowrap">SENTRA KREASI</span>
    </Fragment>
