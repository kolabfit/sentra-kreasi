---
import Layout from '~/layouts/PageLayout.astro';
import Hero from '~/components/widgets/Hero.astro';
// import Note from '~/components/widgets/Note.astro';
// import Features from '~/components/widgets/Features.astro';
import Features2 from '~/components/widgets/Features2.astro';
// import Steps from '~/components/widgets/Steps.astro';
import Content from '~/components/widgets/Content.astro';
// import BlogLatestPosts from '~/components/widgets/BlogLatestPosts.astro';
// import FAQs from '~/components/widgets/FAQs.astro';
// import Stats from '~/components/widgets/Stats.astro ';
import CallToAction from '~/components/widgets/CallToAction.astro';
import HomeEvents from '~/components/contentfulComponents/HomeEvents.astro';
import sorban from '~/assets/images/sorban.png';
import peci from '~/assets/images/peci.png';
import kaos from '~/assets/images/peci.png';
import dompet from '~/assets/images/dompet.png';
import Maps from '~/components/widgets/Maps.astro';
import Headline from '~/components/ui/Headline.astro';
import ProductContents from '~/components/contentfulComponents/ProductContents.astro';
import ContactList from '~/components/contentfulComponents/ContactList.astro';
// import { string } from 'astro:schema';

const metadata = {
  title: 'KOMUNITAS SENTRA KREASI',
  ignoreTitleTemplate: true,
};
---

<Layout metadata={metadata}>
  <!-- Hero Widget ******************* -->

  <Hero image={{ src: '~/assets/images/bg.jpg', alt: 'BG' }}>
    <Fragment slot="title">
      Komunitas Kampung <br /><span class="text-accent dark:text-white highlight">Digital Sentra Kreasi</span>
    </Fragment>

    <Fragment slot="subtitle">
      <span class="hidden sm:inline">
        <span class="font-semibold">Kabupaten Bandung</span> pada awalnya merupakan sebuah tempat/ komunitas dimana para
        pelaku UKM dari Kecamatan Pameungpeuk dan sekitarnya (Baleendah, Arjasari dan Banjaran) berkumpul.</span
      >
    </Fragment>
  </Hero>
  
  <Headline
    title='Produk UKM Sentral Kreasi'
    tagline='Highlight Produk'
    classes={{
      container: 'max-w-xl sm:mx-auto lg:max-w-2xl',
      title: 'text-4xl md:text-5xl font-bold tracking-tighter mb-4 font-heading',
      subtitle: 'max-w-3xl mx-auto sm:text-center text-xl text-muted dark:text-slate-400',
    }}
  />

  <!-- Produk Content -->

  <ProductContents
    id="produk-ukm"
    isDark={false}
   />

  <!-- Home Events -->

  <Headline 
    title='Events' 
    subtitle='Event - event yang sudah diselenggarakan' 
    tagline='UKM SENTRA KREASI'/>
    
  <HomeEvents columns={2}>
    <Fragment slot="more">
      <div class="mt-8 text-center">
        <a href="/tags" class="text-blue-600 hover:text-blue-800 font-semibold"> Lihat Semua Event </a>
      </div>
    </Fragment>
  </HomeEvents>
  
  <Headline
    title="Find Us"
    subtitle="Kunjungi Kami"
  />

  <!-- Maps Widget -->

  <Maps />

  <!-- Contacts -->

  <ContactList
    id="contact-list"
    isDark={false}
    classes={{
      container: 'max-w-7xl mx-auto py-12',
      panel: 'rounded-lg shadow-[0_4px_30px_rgba(0,0,0,0.1)] dark:shadow-[0_4px_30px_rgba(0,0,0,0.1)] backdrop-blur border border-[#ffffff29] bg-white dark:bg-slate-900 p-6 text-center flex flex-col items-center justify-center w-full h-full',
      title: 'text-center',
      deskripsi: 'text-center',
      image: 'mx-auto w-full rounded-lg bg-gray-500 shadow-lg',
    }}
  />

  <!-- CallToAction Widget *********** -->

  <CallToAction
    actions={[
      {
        variant: 'primary',
        text: 'Kunjungi',
        href: 'https://www.instagram.com/sentrakreasi.ukm?utm_source=ig_web_button_share_sheet&igsh=ZDNlZDc0MzIxNw==',
        target: '_blank',
      },
    ]}
  >
    <Fragment slot="title">
      KOMUNITAS KAMPUNG DIGITAL&nbsp;<br class="block sm:hidden" /><span class="sm:whitespace-nowrap"
        >SENTRA KREASI</span
      >
    </Fragment>
  </CallToAction>
</Layout>
