        title: 'Pembuatan konten digital untuk umkm desa pangalengan',
        description: "Sharing pembuatan konten digital untuk umkm desa pangalengan",
        icon: 'flat-color-icons:template',
      },
      {
        title: 'Program desa umkm pangalengan telkom indonesia x telkom university',
        description:
          "Sharing & kickoff program desa umkm pangalengan telkom indonesia x telkom university",
        icon: 'flat-color-icons:gallery',
      },
      {
        title: 'Pelatihan kupas tuntas sukses live shopee',
        icon: 'flat-color-icons:approval',
      },
      {
        title: 'Kunjungan kerja kampung digital sentra kreasi di gunung puntang ',
        icon: 'flat-color-icons:document',
      },
    ]}
  >
    <Fragment slot="bg">
      <div class="absolute inset-0 bg-blue-50 dark:bg-transparent"></div>
    </Fragment>
  </Features2>

