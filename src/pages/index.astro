---
import Layout from '~/layouts/PageLayout.astro';
import Hero from '~/components/widgets/Hero.astro';
// import Note from '~/components/widgets/Note.astro';
// import Features from '~/components/widgets/Features.astro';
import Features2 from '~/components/widgets/Features2.astro';
// import Steps from '~/components/widgets/Steps.astro';
import Content from '~/components/widgets/Content.astro';
// import BlogLatestPosts from '~/components/widgets/BlogLatestPosts.astro';
// import FAQs from '~/components/widgets/FAQs.astro';
// import Stats from '~/components/widgets/Stats.astro ';
import CallToAction from '~/components/widgets/CallToAction.astro';
import sorban from '~/assets/images/sorban.png';
import peci from '~/assets/images/peci.png';
import kaos from '~/assets/images/peci.png';
import dompet from '~/assets/images/dompet.png'
import Maps from '~/components/widgets/Maps.astro';
// import { string } from 'astro:schema';

const metadata = {
  title: 'KOMUNITAS SENTRA KREASI',
  ignoreTitleTemplate: true,
};
---

<Layout metadata={metadata}>
  <!-- Hero Widget ******************* -->

  <Hero
    image={{ src: '~/assets/images/bg.jpg', alt: 'BG' }}
  >
    <Fragment slot="title">
      Komunitas Kampung <br><span class="text-accent dark:text-white highlight">Digital Sentra Kreasi</span>
    </Fragment>

    <Fragment slot="subtitle">
      <span class="hidden sm:inline"> 
        <span class="font-semibold">Kabupaten Bandung</span> pada awalnya merupakan sebuah 
        tempat/ komunitas dimana para pelaku UKM dari 
        Kecamatan Pameungpeuk dan sekitarnya (Baleendah, 
        Arjasari dan Banjaran) berkumpul.</span>
    </Fragment>
  </Hero>

  <!-- Content Widget **************** -->

  <Content
    tagline="Highlight Produk"
    title="Produk UKM Sentral Kreasi"
    items={[
      {
        title:
          'Produsen peci Manis HM TOHA Original Bandung, Pastikan peci manis anda asli.',
      },
    ]}
    image={{ src: peci, alt: 'peci' }}
  >
    <Fragment slot="content">
      <h3 class="text-2xl font-bold tracking-tight dark:text-white sm:text-3xl mb-2">Peci/Songkok</h3>
    </Fragment>

    <Fragment slot="bg">
      <div class="absolute inset-0 bg-blue-50 dark:bg-transparent"></div>
    </Fragment>
  </Content>

  <!-- Content Widget **************** -->

  <Content
    isReversed
    isAfterContent
    items={[
      {
        title: 'Sorban Permanen dan Ikat Kepala',
      },
    ]}
    image={{ src: sorban, alt: 'sorban' }}
  >
    <Fragment slot="content">
      <h3 class="text-2xl font-bold tracking-tight dark:text-white sm:text-3xl mb-2">Sorban</h3>
    </Fragment>

    <Fragment slot="bg">
      <div class="absolute inset-0 bg-blue-50 dark:bg-transparent"></div>
    </Fragment>
  </Content>

  <!-- Content Widget **************** -->

  <Content
    isAfterContent
    items={[
      {
        title: 'Souvenir Pernikahan - Allure',
      },
    ]}
    image={{ src: dompet, alt: 'dompet' }}
  >

  <Fragment slot="content">
    <h3 class="text-2xl font-bold tracking-tight dark:text-white sm:text-3xl mb-2">Souvenir</h3>
  </Fragment>

    <Fragment slot="bg">
      <div class="absolute inset-0 bg-blue-50 dark:bg-transparent"></div>
    </Fragment>
  </Content>

  <Content
    isReversed
    isAfterContent
    items={[
      {
        title: 'Kaos Polos Bandung',
        description:
        'Kaos Berkualitas Harga Pas. 100% Made In Bandung',
      },
    ]}
    image={{ src: kaos, alt: 'kaos' }}
  >

  <Fragment slot="content">
    <h3 class="text-2xl font-bold tracking-tight dark:text-white sm:text-3xl mb-2">Kaos</h3>
  </Fragment>

    <Fragment slot="bg">
      <div class="absolute inset-0 bg-blue-50 dark:bg-transparent"></div>
    </Fragment>
  </Content>

