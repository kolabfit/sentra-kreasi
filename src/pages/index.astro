---
import Layout from '~/layouts/PageLayout.astro';
import Hero from '~/components/widgets/Hero.astro';
// import Note from '~/components/widgets/Note.astro';
// import Features from '~/components/widgets/Features.astro';
import Features2 from '~/components/widgets/Features2.astro';
// import Steps from '~/components/widgets/Steps.astro';
import Content from '~/components/widgets/Content.astro';
// import BlogLatestPosts from '~/components/widgets/BlogLatestPosts.astro';
// import FAQs from '~/components/widgets/FAQs.astro';
// import Stats from '~/components/widgets/Stats.astro ';
import CallToAction from '~/components/widgets/CallToAction.astro';
import HomeEvents from '~/components/contentfulComponents/HomeEvents.astro';
import sorban from '~/assets/images/sorban.png';
import peci from '~/assets/images/peci.png';
import kaos from '~/assets/images/peci.png';
import dompet from '~/assets/images/dompet.png';
import Maps from '~/components/widgets/Maps.astro';
import Headline from '~/components/ui/Headline.astro';
// import { string } from 'astro:schema';

const metadata = {
  title: 'KOMUNITAS SENTRA KREASI',
  ignoreTitleTemplate: true,
};
---

<Layout metadata={metadata}>
  <!-- Hero Widget ******************* -->

  <Hero image={{ src: '~/assets/images/bg.jpg', alt: 'BG' }}>
    <Fragment slot="title">
      Komunitas Kampung <br /><span class="text-accent dark:text-white highlight">Digital Sentra Kreasi</span>
    </Fragment>

    <Fragment slot="subtitle">
      <span class="hidden sm:inline">
        <span class="font-semibold">Kabupaten Bandung</span> pada awalnya merupakan sebuah tempat/ komunitas dimana para
        pelaku UKM dari Kecamatan Pameungpeuk dan sekitarnya (Baleendah, Arjasari dan Banjaran) berkumpul.</span
      >
    </Fragment>
  </Hero>
  
  <Headline
    title='Produk UKM Sentral Kreasi'
    tagline='Highlight Produk'
    classes={{
      container: 'max-w-xl sm:mx-auto lg:max-w-2xl',
      title: 'text-4xl md:text-5xl font-bold tracking-tighter mb-4 font-heading',
      subtitle: 'max-w-3xl mx-auto sm:text-center text-xl text-muted dark:text-slate-400',
    }}
  />

  <!-- Content Widget **************** -->

  <Content
    items={[
      {
        title: 'Produsen peci Manis HM TOHA Original Bandung, Pastikan peci manis anda asli.',
        description: 'Peci Manis HM TOHA Original Bandung merupakan produk unggulan dari Sentra Kreasi yang dirancang khusus untuk memenuhi kebutuhan aksesoris kepala bagi para pria muslim. Dengan desain yang elegan dan kualitas terbaik, peci ini dijamin akan memberikan kesan yang tak terlupakan bagi pemakainya.',
      },
    ]}
    image={{ src: peci, alt: 'peci' }}
  >
  </Content>

  <!-- Content Widget **************** -->

  <Content
    isReversed
    isAfterContent
    items={[
      {
        title: 'Sorban Permanen dan Ikat Kepala',
        description: 'Sorban Permanen dan Ikat Kepala merupakan produk unggulan dari Sentra Kreasi yang dirancang khusus untuk memenuhi kebutuhan aksesoris kepala bagi para pria muslim. Dengan desain yang elegan dan kualitas terbaik, sorban ini dijamin akan memberikan kesan yang tak terlupakan bagi pemakainya.',
      },
    ]}
    image={{ src: sorban, alt: 'sorban' }}
  >
  </Content>

  <!-- Content Widget **************** -->

  <Content
    isAfterContent
    items={[
      {
        title: 'Souvenir Pernikahan - Allure',
        description: 'Souvenir Pernikahan - Allure merupakan produk unggulan dari Sentra Kreasi yang dirancang khusus untuk memenuhi kebutuhan souvenir pernikahan yang elegan dan eksklusif. Dengan desain yang menawan dan kualitas terbaik, souvenir ini dijamin akan memberikan kesan yang tak terlupakan bagi para tamu undangan.',
      },
    ]}
    image={{ src: dompet, alt: 'dompet' }}
  >
  </Content>

  <Content
    isReversed
    isAfterContent
    items={[
      {
        title: 'Kaos Polos Bandung',
        description: 'Kaos Berkualitas Harga Pas. 100% Made In Bandung',
      },
    ]}
    image={{ src: kaos, alt: 'kaos' }}
  >
  </Content>

  <!-- Features2 Widget ************** -->

  <Headline 
    title='Events' 
    subtitle='Event - event yang sudah diselenggarakan' 
    tagline='UKM SENTRA KREASI'/>
  <HomeEvents
    columns={2}
  >

    <Fragment slot="more">
      <div class="mt-8 text-center">
        <a href="/tags" class="text-blue-600 hover:text-blue-800 font-semibold"> Lihat Semua Event </a>
      </div>
    </Fragment>
  </HomeEvents>
  
  <Features2
    title="Find Us"
    subtitle="Kunjungi Kami"
  />

  <Maps />

  <Features2
    columns={2}
    items={[
      {
        title: 'Alamat',
        description:
          'Jl. Raya Banjaran KM 14, Gg. Kesehatan No 124, RT 05/ RW 06, Desa Sukasari, Kec. Pameungpeuk Bandung',
        icon: 'tabler:location',
      },
      {
        title: 'Call us',
        description: 'WA : 089611284382',
        icon: 'tabler:phone',
      },
    ]}
  />

  <!-- CallToAction Widget *********** -->

  <CallToAction
    actions={[
      {
        variant: 'primary',
        text: 'Kunjungi',
        href: 'https://www.instagram.com/sentrakreasi.ukm?utm_source=ig_web_button_share_sheet&igsh=ZDNlZDc0MzIxNw==',
        target: '_blank',
      },
    ]}
  >
    <Fragment slot="title">
      KOMUNITAS KAMPUNG DIGITAL&nbsp;<br class="block sm:hidden" /><span class="sm:whitespace-nowrap"
        >SENTRA KREASI</span
      >
    </Fragment>
  </CallToAction>
</Layout>
