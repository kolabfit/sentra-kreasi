---
import Layout from '~/layouts/PageLayout.astro';
import Image from '~/components/common/Image.astro';
import { Icon } from 'astro-icon/components';
import DListItem from '~/components/ui/DListItem.astro';

const metadata = {
  title: "AstroWind Template in Depth",
  robots: {
    index: true,
    follow: true,
  },
};
---
<Layout metadata={metadata}>
  <section class="px-4 md:px-6 py-12 sm:py-16 lg:py-20 mx-auto max-w-4xl">
    <h1 class="text-3xl font-bold mb-8">AstroWind Template in Depth</h1>

    <article class="grid grid-cols-1 md:grid-cols-2 gap-6 mb-12 md:mb-20">
      <!-- Article Image -->
      <a href="javascript:void(0)" class="relative block">
        <div class="relative h-0 pb-[56.25%] overflow-hidden bg-gray-400 dark:bg-slate-700 rounded shadow-lg">
          <Image
            src="https://images.unsplash.com/photo-1534307671554-9a6d81f4d629?ixlib=rb-4.0.3&ixid=M3wxMjA3fDB8MHxwaG90by1wYWdlfHx8fGVufDB8fHx8fA%3D%3D&auto=format&fit=crop&w=1651&q=80"
            class="absolute inset-0 object-cover w-full h-full rounded shadow-lg"
            width={900}
            alt="AstroWind Template in Depth"
            aspectRatio="16:9"
            loading="lazy"
            decoding="async"
          />
        </div>
      </a>

      <!-- Article Content -->
      <div>
        <header class="mb-4">
          <div class="flex items-center text-sm text-gray-500 dark:text-gray-400">
            <Icon name="tabler:clock" class="w-4 h-4 mr-1" />
            <time datetime="2023-07-17">July 17, 2023</time>
            <span class="mx-2">·</span>
            <Icon name="tabler:user" class="w-4 h-4 mr-1" />
            <span>testAuthor</span>
            <span class="mx-2">·</span>
            <a href="/" class="hover:underline">Documentation</a>
          </div>
          <h2 class="text-xl sm:text-2xl font-bold mt-2 dark:text-slate-300">
            <a href="/" class="hover:text-primary dark:hover:text-blue-700 transition">
              AstroWind Template in Depth
            </a>
          </h2>
        </header>

        <p class="text-lg text-gray-700 dark:text-slate-400 mb-4">
          While easy to get started, AstroWind is quite complex internally. This page provides documentation on some of the more intricate parts.
        </p>

        <footer>
          <ul class="flex flex-wrap text-sm mb-4">
            <li class="bg-gray-100 dark:bg-slate-700 text-gray-700 dark:text-gray-300 py-1 px-2 mr-2 mb-2 rounded">
              astro
            </li>
            <li class="bg-gray-100 dark:bg-slate-700 text-gray-700 dark:text-gray-300 py-1 px-2 mr-2 mb-2 rounded">
              tailwind css
            </li>
            <li class="bg-gray-100 dark:bg-slate-700 text-gray-700 dark:text-gray-300 py-1 px-2 mr-2 mb-2 rounded">
              front-end
            </li>
          </ul>
        </footer>
      </div>
    </article>
  </section>
